    {
      "name": "Chat",
      "item": [
        {
          "name": "Chat Completions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a helpful assistant.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Hello! What can you do?\"\n    }\n  ],\n  \"max_tokens\": 512,\n  \"temperature\": 0.7,\n  \"top_p\": 0.9,\n  \"stream\": false,\n  \"use_rag\": false,\n  \"enable_thinking\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/v1/chat/completions",
            "description": "Generate a chat completion. Requires a model to be loaded first (POST /v1/models/load).\n\n- stream: true returns SSE (text/event-stream).\n- use_rag: true injects retrieved context from the vector store.\n- enable_thinking: true/false for reasoning models (Qwen3.5); null = template default."
          },
          "response": []
        },
        {
          "name": "Execute Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Explain how quantum computing works in simple terms.\",\n  \"task_type\": \"text_generation\",\n  \"generation_kwargs\": {\n    \"max_tokens\": 256,\n    \"temperature\": 0.7\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/v1/chat/execute",
            "description": "Universal execution endpoint. Pass a raw JSON payload to the engine's generate(); the whole body is used as input_data and generation_kwargs are forwarded. Returns structured JSON."
          },
          "response": []
        },
        {
          "name": "Switch Mode",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/chat/mode/switch?mode=fullram",
              "query": [
                {
                  "key": "mode",
                  "value": "fullram"
                }
              ]
            },
            "description": "Switch execution mode for the currently loaded model. Valid modes: fullram, layerstream, auto."
          },
          "response": []
        }
      ]
    },
