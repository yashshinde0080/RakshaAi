{
  "info": {
    "_postman_id": "7b3f1a6e-2c4d-4e8f-9a1b-5c6d7e8f9a0b",
    "name": "SovereignAI Edge API",
    "description": "Postman collection for the SovereignAI Edge portable offline AI compute platform (FastAPI backend).\n\nBase URL: {{baseUrl}} (default http://127.0.0.1:8000)\n\nAll API routes are prefixed with /v1. WebSocket metrics stream available at ws://127.0.0.1:8000/ws/metrics (Postman supports this via the WebSocket request type).\n\nTypical flow:\n1. GET /v1/models/  — list installed models\n2. POST /v1/models/load  — load a model\n3. POST /v1/chat/completions  — chat\n4. POST /v1/benchmark/run  — benchmark\n5. POST /v1/rag/upload  — ingest a document, then /v1/rag/query",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "modelId",
